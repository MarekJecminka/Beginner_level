def get_number(number):
    while True:
        operand = input("Input number " + str(number) + ": ")
        try:
            return float(operand)
        except:
            print("Write a number next time.")

operand = get_number(1)
operand2 = get_number(2)
sign = input("Input sign: ")

result = 0
if sign == "+":
    result = operand + operand2
elif sign == "-":
    result = operand - operand2
elif sign == "*":
    result = operand * operand2
elif sign == "/":
    if operand2 != 0:
        result = operand / operand2
    else:
        print("Division by zero!")
else:
    print("Enter a correct sign.")

print(result)
