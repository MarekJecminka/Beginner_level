import string
import secrets

def password_generator(pwd_length=12):
    letters = string.ascii_letters
    digits = string.digits
    special_characters = string.punctuation

    alphabet = letters + digits + special_characters

    pwd = ""
    pwd_strong = False

    while not pwd_strong:
        pwd = ""
        pwd += "".join(secrets.choice(alphabet) for char in range(pwd_length))

    if (any(char in special_characters for char in pwd) and sum(char in digits for char in pwd)>=2):
        pwd_strong = True

    return pwd

print(password_generator())
