import random
options = ["rock","paper","scissors"]
user_wins = 0
computer_wins = 0

print("Lets play rock, paper, scissors game.\n")

while True:
    player_pick = input("What do you pick? (rock/paper/scissors or Q to quit)? ").lower()
   
    if player_pick == "q":
        break

    if player_pick not in options:
        continue

    random_number = random.randint(0,2)
    computer_pick = options[random_number]
    print("Computer picked " + computer_pick + ".")

    if player_pick == "rock" and computer_pick == "scissors":
        print("You won!")
        user_wins += 1

    elif player_pick == "paper" and computer_pick == "rock":
        print("You won!")
        user_wins += 1

    elif player_pick == "scissors" and computer_pick == "paper":
        print("You won!")
        user_wins += 1

    else:
        print("You loose!")
        computer_wins += 1

print("You won " + str(user_wins) + " times. Computer won " + str(computer_wins) + " times. Thank you for playing!")
